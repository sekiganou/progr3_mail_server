<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.3-internal" fx:controller="progr3.mail.server.app.LogViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Mail Server Logging System" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    
    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search logs..." prefWidth="300.0" />
        <Button fx:id="refreshButton" text="Refresh" onAction="#onRefreshClick" />
        <Button fx:id="clearButton" text="Clear" onAction="#onClearClick" />
    </HBox>

    <TableView fx:id="logTableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="logLevelColumn" text="Level" prefWidth="80.0" />
            <TableColumn fx:id="timestampColumn" text="Timestamp" prefWidth="240.0" />
            <TableColumn fx:id="requestIdColumn" text="Request ID" prefWidth="180.0" />
            <TableColumn fx:id="messageColumn" text="Message" prefWidth="450.0" />
        </columns>
    </TableView>

    <HBox spacing="20.0" alignment="CENTER_LEFT">
        <Label fx:id="statusLabel" text="Ready" />
        <Label fx:id="logCountLabel" text="Total logs: 0" />
    </HBox>
</VBox>
